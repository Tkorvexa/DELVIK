{
  "trailingSlash": "never",
  "routes": [
    {
      "route": "/build.html",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/build",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/build/*",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/index.html",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/contact-build.html",
      "redirect": "/contact-build",
      "statusCode": 301
    },
    {
      "route": "/areas-served.html",
      "redirect": "/areas-served",
      "statusCode": 301
    },
    {
      "route": "/assets/*.{avif,gif,ico,jpg,jpeg,png,svg,webp}",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/logos/*.{avif,gif,ico,jpg,jpeg,png,svg,webp}",
      "headers": {
        "Cache-Control": "public, max-age=2592000, stale-while-revalidate=86400"
      }
    },
    {
      "route": "/*.css",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/*.xml",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/*.txt",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    }
  ],
  "globalHeaders": {
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "X-Content-Type-Options": "nosniff"
  },
  "mimeTypes": {
    ".avif": "image/avif",
    ".webp": "image/webp",
    ".xml": "application/xml; charset=utf-8",
    ".txt": "text/plain; charset=utf-8"
  }
}
